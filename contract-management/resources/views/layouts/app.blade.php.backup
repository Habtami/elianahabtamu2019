                    ->where(function($query) {
                        $query->where('status', \App\Models\Contract::STATUS_EXPIRING)
                              ->orWhereRaw('performance_guarantee_end_date IS NOT NULL AND DATEDIFF(performance_guarantee_end_date, NOW()) BETWEEN 0 AND performance_guarantee_alert_days');
                    })
                    ->count();
            }
